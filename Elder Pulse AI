});

/* Senior mode toggle */
$(document).on('click','#toggle_senior',function(){
  $('body').toggleClass('senior-mode');
  var on=$('body').hasClass('senior-mode');
  $(this).text(on?'🔎 Senior Mode: ON':'🔎 Senior Mode: OFF');
  $(this).toggleClass('on',on);
});

/* ECG topbar animation */
function runECG(){
  var c=document.getElementById('ecgcvs');if(!c)return;
  var ctx=c.getContext('2d'),w=c.width,h=c.height,t=0;
  function draw(){
    ctx.clearRect(0,0,w,h);
    ctx.strokeStyle='#5580FF';ctx.lineWidth=1.4;ctx.beginPath();
    for(var x=0;x<w;x++){
      var p=((x+t)%140)/140,y;
      if(p<.08)y=h/2;
      else if(p<.13)y=h/2-7;
      else if(p<.16)y=h/2+4;
      else if(p<.20)y=h/2-45;
      else if(p<.26)y=h/2+24;
      else if(p<.30)y=h/2-14;
      else if(p<.36)y=h/2;
      else y=h/2+Math.sin((p-.36)*Math.PI*10)*2;
      x===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    }
    ctx.stroke();t+=1.6;requestAnimationFrame(draw);
  }
  draw();
}
setTimeout(runECG,600);

var hbBase=70,hbVar=0;
setInterval(function(){
  hbVar+=(Math.random()-.48)*2;hbVar=Math.max(-8,Math.min(8,hbVar));
  var bpm=Math.round(hbBase+hbVar);
  var el=document.getElementById('hbnum');if(el)el.textContent=bpm+' bpm';
},1200);

Shiny.addCustomMessageHandler('animGauge',function(m){
  var svg=document.getElementById('cvdGaugeSvg');if(!svg)return;
  var arc=svg.querySelector('#gaugeArc');
  var lbl=document.getElementById('gaugePct');
  var txt=document.getElementById('gaugeRisk');
  var r=70,circ=Math.PI*r;
  var offset=circ-(m.pct/100)*circ;
  if(arc){arc.setAttribute('stroke-dasharray',circ);arc.setAttribute('stroke-dashoffset',offset);arc.setAttribute('stroke',m.color);}
  if(lbl){var cur=0,step=m.pct/50,iv=setInterval(function(){cur=Math.min(cur+step,m.pct);lbl.textContent=Math.round(cur)+'%';if(cur>=m.pct)clearInterval(iv);},20);}
  if(txt){txt.textContent=m.label;txt.style.color=m.color;}
});

var ttsOn=false,curU=null;
Shiny.addCustomMessageHandler('setTTS',function(m){
  ttsOn=m.on;
  if(!ttsOn&&curU)window.speechSynthesis.cancel();
  var b=document.getElementById('ttsBtn');
  if(b){b.className=ttsOn?'btnteal tts-on':'btnteal';
    b.innerHTML=ttsOn?'🔊 Voice ON — Click to Disable':'🔇 Enable Voice Replies';}
});
Shiny.addCustomMessageHandler('speak',function(txt){
  if(!ttsOn||!('speechSynthesis' in window))return;
  window.speechSynthesis.cancel();
  curU=new SpeechSynthesisUtterance(txt);
  curU.rate=0.88;curU.pitch=1;curU.lang='en-US';
  var vs=window.speechSynthesis.getVoices();
  var v=vs.find(function(x){return x.name.includes('Samantha')||x.name.includes('Google US English')||x.name.includes('Karen');});
  if(v)curU.voice=v;
  window.speechSynthesis.speak(curU);
});

var stt=null;
Shiny.addCustomMessageHandler('initSTT',function(){
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window))return;
  stt=new(window.SpeechRecognition||window.webkitSpeechRecognition)();
  stt.continuous=false;stt.interimResults=false;stt.lang='en-US';
  stt.onresult=function(e){
    var t=e.results[0][0].transcript;
    Shiny.setInputValue('stt_in',t,{priority:'event'});
    var ta=document.getElementById('chatTxt');if(ta)ta.value=t;
    var mb=document.getElementById('micBtn');if(mb)mb.classList.remove('stt-active');
  };
  stt.onend=function(){var b=document.getElementById('micBtn');if(b)b.classList.remove('stt-active');};
});
Shiny.addCustomMessageHandler('sttStart',function(){if(stt){stt.start();document.getElementById('micBtn').classList.add('stt-active');}});
Shiny.addCustomMessageHandler('sttStop',function(){if(stt)stt.stop();});

var heartStt=null;
Shiny.addCustomMessageHandler('initHeartSTT',function(){
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window))return;
  heartStt=new(window.SpeechRecognition||window.webkitSpeechRecognition)();
  heartStt.continuous=false;heartStt.interimResults=false;heartStt.lang='en-US';
  heartStt.onresult=function(e){
    var t=e.results[0][0].transcript;
    Shiny.setInputValue('heart_voice_in',t,{priority:'event'});
    var orb=document.getElementById('heartOrb');if(orb)orb.classList.remove('speaking');
    activateWave(false);
  };
  heartStt.onend=function(){var o=document.getElementById('heartOrb');if(o)o.classList.remove('speaking');activateWave(false);};
});
Shiny.addCustomMessageHandler('heartSpeak',function(txt){
  var orb=document.getElementById('heartOrb');if(orb)orb.classList.add('speaking');
  activateWave(true);
  if('speechSynthesis' in window){
    window.speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance(txt);u.rate=.88;u.pitch=1.02;u.lang='en-US';
    var vs=window.speechSynthesis.getVoices();
    var v=vs.find(function(x){return x.name.includes('Samantha')||x.name.includes('Google US English');});
    if(v)u.voice=v;
    u.onend=function(){if(orb)orb.classList.remove('speaking');activateWave(false);};
    window.speechSynthesis.speak(u);
  }
});
function activateWave(on){
  document.querySelectorAll('.wbar').forEach(function(b,i){
    if(on){b.classList.add('active');b.style.animationDelay=(i*.08)+'s';}
    else{b.classList.remove('active');b.style.height='6px';}
  });
}
$(document).on('click','#heartOrb',function(){
  Shiny.setInputValue('heart_orb_click',Date.now(),{priority:'event'});
  if(heartStt){heartStt.start();$(this).addClass('speaking');activateWave(true);}
});

Shiny.addCustomMessageHandler('bubble',function(m){
  var box=document.getElementById('chatBox');if(!box)return;
  var u=m.role==='user';
  var d=document.createElement('div');d.className='cmsg '+(u?'cmsg-u':'cmsg-b');
  var t=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  d.innerHTML='<div class=\"cbub '+(u?'cbu':'cbb')+'\">'+m.text.replace(/\\n/g,'<br>')+'</div>'+
    '<div class=\"cmeta\">'+(u?'You':'ElderPulse Companion')+' &middot; '+t+'</div>';
  box.appendChild(d);box.scrollTop=box.scrollHeight;
});

Shiny.addCustomMessageHandler('animRing',function(m){
  var arc=document.getElementById('ringArc');if(!arc)return;
  var c=2*Math.PI*52;
  arc.setAttribute('stroke-dasharray',c);arc.setAttribute('stroke-dashoffset',c);arc.setAttribute('stroke',m.color);
  setTimeout(function(){arc.setAttribute('stroke-dashoffset',c-(m.score/100)*c);},100);
  var n=document.getElementById('ringNum'),w=document.getElementById('ringWord');
  if(n){n.style.color=m.color;var cur=0,step=m.score/60,iv=setInterval(function(){
    cur=Math.min(cur+step,m.score);n.textContent=Math.round(cur);if(cur>=m.score)clearInterval(iv);},16);}
  if(w)w.textContent=m.label;
});

$(document).on('click','.shopitem',function(){$(this).toggleClass('bought');});

$(document).on('click','.kcard',function(){
  var col=$(this).closest('.kanban-col');
  var cols=$('.kanban-col');
  var idx=cols.index(col);
  if(idx<cols.length-1){
    $(this).fadeOut(200,function(){$(this).appendTo(cols.eq(idx+1)).fadeIn(200);updateKcounts();});
  }
});
function updateKcounts(){
  $('.kanban-col').each(function(){
    var n=$(this).find('.kcard').length;
    $(this).find('.kcount').text(n);
  });
}
