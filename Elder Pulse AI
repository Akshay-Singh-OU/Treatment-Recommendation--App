GEMINIKEY <- "AQ.Ab8RN6JbcoST2eM5imF_BauSQKXosnV7D51PRE58Zv6diYyNdg"

GEMINI_MODELS <- c(
  "gemini-3.5-flash",
  "gemini-3.1-flash-lite",
  "gemini-2.5-flash",
  "gemini-2.0-flash",
  "gemini-1.5-flash"
)

gemini_url_for <- function(model) {
  paste0("https://generativelanguage.googleapis.com/v1beta/models/", model, ":generateContent")
}

gemini <- function(prompt, sys = NULL, maxtokens = 1400, model = "gemini-3.5-flash") {
  fullprompt <- if (!is.null(sys)) paste0(sys, "\n\n", prompt) else prompt
  body <- list(
    contents = list(list(parts = list(list(text = as.character(fullprompt))))),
    generationConfig = list(maxOutputTokens = maxtokens, temperature = 0.7)
  )
  bd  <- jsonlite::toJSON(body, auto_unbox = TRUE)
  url <- gemini_url_for(model)
  r <- tryCatch(
    httr::POST(url, httr::add_headers(`Content-Type` = "application/json"),
               query = list(key = GEMINIKEY), body = bd, encode = "raw", httr::timeout(60)),
    error = function(e) e
  )
  if (inherits(r, "error")) return(list(ok = FALSE, text = paste0("Network error: ", r$message)))
  st <- httr::status_code(r)
  rw <- tryCatch(httr::content(r, as = "text", encoding = "UTF-8"), error = function(e) "")
  if (st != 200) return(list(ok = FALSE, text = paste0("HTTP ", st, ": ", substr(rw, 1, 400))))
  parsed <- tryCatch(jsonlite::fromJSON(rw, simplifyVector = FALSE), error = function(e) NULL)
  tx <- tryCatch(parsed$candidates[[1]]$content$parts[[1]]$text, error = function(e) NULL)
  if (!is.null(tx) && nchar(tx) > 0) return(list(ok = TRUE, text = as.character(tx)))
  list(ok = FALSE, text = paste0("Parsed OK but no text found. Raw: ", substr(rw, 1, 300)))
}

# ── Clinical helpers ─────────────────────────────────────────────────
calcBMI <- function(h, w) round(w / (h / 100)^2, 1)

bmiCat <- function(b) {
  if (b < 18.5) "Underweight" else if (b < 25) "Normal" else if (b < 30) "Overweight" else "Obese"
}

htRisk <- function(nd) ifelse(nd$ap_hi >= 140 | nd$ap_lo >= 90 | nd$age >= 50 | nd$weight >= 80, "High", "Low")
dbRisk <- function(nd) ifelse(nd$gluc >= 2 | nd$cholesterol >= 2 | nd$age >= 45 | nd$weight >= 75, "High", "Low")

healthScore <- function(prob, ht, db, bmi, active, smoke, alco) {
  s <- 100 - round(prob * 40)
  if (ht == "High") s <- s - 15
  if (db == "High") s <- s - 12
  if (bmi >= 30) s <- s - 10 else if (bmi >= 25) s <- s - 5
  if (smoke == 1) s <- s - 10
  if (alco == 1) s <- s - 5
  if (active == 1) s <- s + 8
  max(0, min(100, s))
}

scoreCol  <- function(s) if (s >= 70) "#3ECFA0" else if (s >= 45) "#FFB347" else "#FF4D6A"
riskLabel <- function(p) if (p >= .7) "Very High" else if (p >= .5) "High" else if (p >= .35) "Moderate" else "Low"

