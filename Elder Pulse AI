  output$xgb_sum <- renderText({ req(rv$xgb_s); paste(rv$xgb_s, collapse = "\n") })
  output$xgb_met <- renderText({ req(rv$xgb_m); paste(rv$xgb_m, collapse = "\n") })

  output$lr_roc  <- renderPlot({ req(rv$lr_r);  dark_roc(rv$lr_r,  "#5580FF", "ROC — Logistic Regression") })
  output$rf_roc  <- renderPlot({ req(rv$rf_r);  dark_roc(rv$rf_r,  "#3ECFA0", "ROC — Random Forest") })
  output$xgb_roc <- renderPlot({ req(rv$xgb_r); dark_roc(rv$xgb_r, "#FF4D6A", "ROC — XGBoost") })

  output$rf_imp <- renderPlot({
    req(rv$rff)
    imp <- importance(rv$rff)
    dfi <- data.frame(F = rownames(imp), G = imp[, "MeanDecreaseGini"])
    dfi <- dfi[order(dfi$G), ]; dfi$F <- factor(dfi$F, levels = dfi$F)
    ggplot(dfi, aes(x = F, y = G)) +
      geom_col(fill = "#5580FF", width = .65) + coord_flip() +
      labs(x = NULL, y = "Mean Decrease Gini", title = "Variable Importance") + dtheme()
  })

} # /server

