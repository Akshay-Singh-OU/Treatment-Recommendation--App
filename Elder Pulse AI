# ═══════════════════════════════════════════════════════════════════════
#  SERVER
# ═══════════════════════════════════════════════════════════════════════
server <- function(input, output, session) {

  observeEvent(input$active_tab, updateTabsetPanel(session, "main_tabs", selected = input$active_tab))

  # TTS
  tts <- reactiveVal(FALSE)
  observeEvent(input$ttsBtn, { tts(!tts()); session$sendCustomMessage("setTTS", list(on = tts())) })
  spk <- function(txt) { if (tts()) session$sendCustomMessage("speak", substr(txt, 1, 600)) }

  # STT
  session$onFlushed(function() {
    session$sendCustomMessage("initSTT", list())
    session$sendCustomMessage("initHeartSTT", list())
  }, once = TRUE)
  observeEvent(input$micBtn,  session$sendCustomMessage("sttStart", list()))
  observeEvent(input$micStop, session$sendCustomMessage("sttStop",  list()))
  observeEvent(input$stt_in,  updateTextAreaInput(session, "chatTxt", value = input$stt_in))

  # State
  rv <- reactiveValues(
    df = NULL, lr = NULL, rf = NULL, xgb = NULL, rff = NULL,
    lr_s = NULL, lr_m = NULL, lr_r = NULL, lr_auc = NULL,
    rf_s = NULL, rf_m = NULL, rf_r = NULL, rf_auc = NULL,
    xgb_s = NULL, xgb_m = NULL, xgb_r = NULL, xgb_auc = NULL,
    ctx = NULL, prob = NULL, ht = NULL, db = NULL, bmi = NULL, bmi_c = NULL, hs = NULL,
    recs = NULL, nrc = NULL, story = NULL, goals = NULL,
    chat_hist = list(), meal_text = NULL,
    caregivers = list(), alert_log = list(),
    safety_status = "normal", safety_msg = "All quiet. No unusual activity detected.",
    safety_time = NULL, safety_log = list(),
    sensor_motion = "Normal", sensor_inactivity = "0 hrs", sensor_last_meds = "On schedule"
  )

  pat <- function() data.frame(
    age = input$pt_age, gender = as.numeric(input$pt_sex),
    height = input$pt_height, weight = input$pt_weight,
    ap_hi = input$pt_sys, ap_lo = input$pt_dia,
    cholesterol = as.numeric(input$pt_chol), gluc = as.numeric(input$pt_gluc),
    smoke = as.numeric(input$pt_smoke), alco = as.numeric(input$pt_alco),
    active = as.numeric(input$pt_active)
  )

  dark_roc <- function(obj, col, ttl) {
    par(bg = "#080C18", col.axis = "#7B88AA", col.lab = "#4E5A78",
        col.main = "#DDE4FF", fg = "#182035", mar = c(4, 4, 3, 1))
    plot(obj, col = col, lwd = 2.5, main = ttl, cex.main = 1, font.main = 1)
    legend("bottomright", bty = "n", legend = paste("AUC =", round(auc(obj), 3)),
           col = col, lwd = 2.5, text.col = "#DDE4FF")
  }

  # ── UPLOAD + TRAIN ─────────────────────────────────────────────────
  observeEvent(input$file, {
    req(input$file)
    df <- tryCatch({
      d <- read.csv(input$file$datapath, sep = ";")
      d$age <- round(d$age / 365); d$cardio <- as.factor(d$cardio); d
    }, error = function(e) { showNotification(paste("File error:", e$message), type = "error"); NULL })
    req(!is.null(df)); rv$df <- df
    feats <- c("age","gender","height","weight","ap_hi","ap_lo","cholesterol","gluc","smoke","alco","active")
    set.seed(42); idx <- createDataPartition(df$cardio, p = .8, list = FALSE)
    tr <- df[idx, ]; te <- df[-idx, ]
    withProgress(message = "Training 3 models…", value = 0, {
      incProgress(.1, detail = "Logistic Regression")
      lr <- glm(cardio ~ age + gender + height + weight + ap_hi + ap_lo + cholesterol + gluc + smoke + alco + active,
                data = tr, family = binomial)
      rv$lr <- lr; rv$lr_s <- capture.output(summary(lr))
      pr_lr <- predict(lr, te, type = "response"); pd_lr <- ifelse(pr_lr > .5, 1, 0)
      rv$lr_m <- capture.output(confusionMatrix(factor(pd_lr), te$cardio))
      rv$lr_r <- roc(as.numeric(as.character(te$cardio)), pr_lr)
      rv$lr_auc <- round(auc(rv$lr_r), 3)
      incProgress(.4, detail = "Random Forest")
      rf <- randomForest(as.factor(cardio) ~ ., data = tr, importance = TRUE, ntree = 100)
      rv$rf <- rv$rff <- rf; rv$rf_s <- capture.output(print(rf))
      pr_rf <- predict(rf, te, type = "prob")[, 2]; pd_rf <- predict(rf, te)
      rv$rf_m <- capture.output(confusionMatrix(pd_rf, te$cardio))
      rv$rf_r <- roc(as.numeric(as.character(te$cardio)), pr_rf)
      rv$rf_auc <- round(auc(rv$rf_r), 3)
      incProgress(.75, detail = "XGBoost")
      trm <- xgb.DMatrix(data = as.matrix(tr[, feats]), label = as.numeric(as.character(tr$cardio)))
      tem <- xgb.DMatrix(data = as.matrix(te[, feats]), label = as.numeric(as.character(te$cardio)))
      xg  <- xgb.train(list(objective = "binary:logistic", eval_metric = "logloss", max_depth = 3, eta = .1),
                        data = trm, nrounds = 50, verbose = 0)
