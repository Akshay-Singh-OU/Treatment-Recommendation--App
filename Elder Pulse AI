      rv$xgb_m <- capture.output(confusionMatrix(factor(pd_x), te$cardio))
      rv$xgb_r <- roc(as.numeric(as.character(te$cardio)), pr_x)
      rv$xgb_auc <- round(auc(rv$xgb_r), 3)
