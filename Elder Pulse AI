      "You are ElderPulse, a warm voice AI companion for an older adult. Speak simply, kindly, and never rush. ",
      "Use short sentences a senior can follow easily. Keep responses to 2-3 short paragraphs. Avoid jargon. ",
      if (!is.null(rv$ctx)) paste0("Their health context: ", rv$ctx) else "")
    withProgress(message = "Companion listening…", { res <- gemini(q, sys = sys) })
    txt <- if (res$ok) res$text else "I couldn't connect right now. Please try again in a moment."
    session$sendCustomMessage("bubble", list(role = "bot", text = txt))
    session$sendCustomMessage("heartSpeak", txt)
    rv$chat_hist <- c(rv$chat_hist, list(list(r = "User", t = q), list(r = "Assistant", t = txt)))
